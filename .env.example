# Copy this file to .env and fill in what you want to use.
# .env is ignored by Git, so your secret webhook URL never goes on GitHub.

# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# ntfy.sh: make up a long, hard-to-guess topic name, e.g. pumpkin-alerts-simon-8392
# then subscribe to the same name in the ntfy phone app
NTFY_TOPIC=
